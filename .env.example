# Public application URL
NEXT_PUBLIC_SITE_URL="https://profesja-premium-limited.vercel.app"

# Database / application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/profesja"

# OWNER panel — NEVER commit real secrets
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD_SALT="generate-with: node scripts/hash-owner-password.mjs YOUR_PASSWORD"
OWNER_PASSWORD_HASH="generate-with: node scripts/hash-owner-password.mjs YOUR_PASSWORD"
OWNER_SESSION_SECRET="generate-a-separate-long-random-secret"

# Scheduled automation — generate a separate random secret (minimum 16 chars)
CRON_SECRET="generate-a-separate-long-random-secret"
