      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPtype": "nxtPtype"
      },
      "namedRegex": "^/admin/orders/(?<nxtPid>[^/]+?)/document/(?<nxtPtype>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/owner/offers/[id]/formalities",
