generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  companyName String
  name        String
  email       String   @unique
  password    String
  role        String   @default("CLIENT")
  createdAt   DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  price       String
  createdAt   DateTime @default(now())
}

model Offer {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  company     String?
  contact     String
  email       String
  phone       String?
  product     String
  quantity    String?
  market      String?
  budget      String?
  details     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  order       Order?
  automation  SalesAutomationCase?
  formalities TransactionFormalities?
  invoices    Invoice[]
  stageLinks  StageLink[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id                   Int      @id @default(autoincrement())
  number               String   @unique
  offerId              Int      @unique
  company              String?
  contact              String
  email                String
  product              String
  quantity             String?
  amount               String?
  status               String   @default("CREATED")
  dispatcherStatus     String   @default("RECEIVED")
  notes                String?
  shippingMethod       String?
  pickupAddress        String?
  shippingAddress      String?
  carrier              String?
  trackingNumber       String?
  trackingUrl          String?
  pickupAt             DateTime?
  estimatedDelivery    DateTime?
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  orderConfirmation    String?
  commercialOffer      String?
  fulfillmentDocument String?
  transportDocument    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  offer                Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([dispatcherStatus])
  @@index([email])
  @@index([createdAt])
  @@index([trackingNumber])
}

model SalesAutomationCase {
  id                        Int      @id @default(autoincrement())
  offerId                   Int      @unique
  mode                      String   @default("SALES")
  stage                     String   @default("INTAKE")
  financingRequested        Boolean  @default(false)
  financingAmount           String?
  financingStatus           String   @default("NOT_REQUESTED")
  confidentialityLevel      String   @default("STRICT")
  externalDisclosureAllowed Boolean  @default(false)
  nextAction                String?
  lastRunAt                 DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  offer                     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  events                    SalesAutomationEvent[]

  @@index([stage])
  @@index([financingStatus])
  @@index([updatedAt])
}

model SalesAutomationEvent {
  id             Int                 @id @default(autoincrement())
  caseId         Int
  type           String
  message        String
  createdAt      DateTime            @default(now())
  automationCase SalesAutomationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([createdAt])
}

model TransactionFormalities {
  id                           Int      @id @default(autoincrement())
  offerId                      Int      @unique
  sourceDocumentVersion        String   @default("FORMALNOSCI-PPL-2026-08-08")
  sourceDocumentName           String   @default("formalności projektu Profesja Premium Limited.pdf")
  productSnapshot              String?
  quantitySnapshot             String?
  marketSnapshot               String?
  valueSnapshot                String?
  financingRequested           Boolean  @default(false)
  financingAmount              String?
  shippingMethodSnapshot       String?
  shippingAddressSnapshot      String?
  estimatedDeliverySnapshot    DateTime?
  negotiationStatus            String   @default("COLLECTING_FACTS")
  clientDeclarationStatus      String   @default("PENDING")
  insuranceConsentStatus       String   @default("PENDING")
  shippingConsentStatus        String   @default("PENDING")
  businessUseConsentStatus     String   @default("PENDING")
  interestConsentStatus        String   @default("PENDING")
  intermediationConsentStatus  String   @default("PENDING")
  monthlySettlementStatus      String   @default("PENDING")
  earlyTerminationStatus       String   @default("PENDING")
  finalSignatureStatus         String   @default("PENDING")
  signatureMethod              String?
  signedAt                     DateTime?
  autoFilledAt                 DateTime?
  lastNegotiationAt            DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  offer                        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([negotiationStatus])
  @@index([finalSignatureStatus])
  @@index([updatedAt])
}

model OwnerLoginAttempt {
  key          String   @id
  failures     Int      @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime @updatedAt
}

// VAT eligibility: EXEMPT_0 only when eligible gates pass; otherwise STANDARD or MANUAL_REVIEW.
model Invoice {
  id                  Int      @id @default(autoincrement())
  number              String   @unique
  offerId             Int
  orderId             Int?
  status              String   @default("DRAFT")
  issuerName          String
  issuerAddress       String
  issuerTaxId         String
  buyerName           String
  buyerAddress        String
  buyerTaxId          String?
  currency            String   @default("PLN")
  netAmount           String
  vatRate             String
  vatAmount           String
  grossAmount         String
  vatEligibility      String   @default("STANDARD")
  vatEligibilityNote  String?
  poReference         String?
  contractReference   String?
  deliveryEvidence    String?
  issuedAt            DateTime @default(now())
  dueDate             DateTime?
  paidAt              DateTime?
  bankIban            String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  offer               Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  factoringPackage    FactoringPackage?

  @@index([offerId])
  @@index([status])
  @@index([issuedAt])
}

// Factoring package: export fields for domestic/international factoring workflows.
model FactoringPackage {
  id                  Int      @id @default(autoincrement())
  invoiceId           Int      @unique
  assignmentStatus    String   @default("NOT_ASSIGNED")
  assignmentConsentAt DateTime?
  assigneeNote        String?
  auditReference      String?
  exportedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([assignmentStatus])
}

// Stage-link: short-link abstraction for workflow stage tracking.
// A click records an event but NEVER creates a debt, charge or hidden obligation.
model StageLink {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  offerId       Int
  stage         String
  shortUrl      String?
  provider      String?
  purpose       String
  expiresAt     DateTime?
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  events        StageLinkEvent[]

  @@index([offerId])
  @@index([token])
  @@index([stage])
}

model StageLinkEvent {
  id         Int       @id @default(autoincrement())
  linkId     Int
  eventType  String
  metadata   String?
  recordedAt DateTime  @default(now())
  link       StageLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([recordedAt])
}
