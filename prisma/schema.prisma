generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  companyName String
  name        String
  email       String   @unique
  password    String
  role        String   @default("CLIENT")
  createdAt   DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  price       String
  createdAt   DateTime @default(now())
}

model Offer {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  company   String?
  contact   String
  email     String
  phone     String?
  product   String
  quantity  String?
  market    String?
  budget    String?
  details   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  order     Order?
  automation SalesAutomationCase?

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id                 Int      @id @default(autoincrement())
  number             String   @unique
  offerId            Int      @unique
  company            String?
  contact            String
  email              String
  product            String
  quantity           String?
  amount             String?
  status             String   @default("CREATED")
  notes              String?
  shippingMethod     String?
  shippingAddress    String?
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  estimatedDelivery  DateTime?
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  orderConfirmation  String?
  commercialOffer    String?
  fulfillmentDocument String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  offer              Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([trackingNumber])
}

model SalesAutomationCase {
  id                        Int      @id @default(autoincrement())
  offerId                   Int      @unique
  mode                      String   @default("SALES")
  stage                     String   @default("INTAKE")
  financingRequested        Boolean  @default(false)
  financingAmount           String?
  financingStatus           String   @default("NOT_REQUESTED")
  confidentialityLevel      String   @default("STRICT")
  externalDisclosureAllowed Boolean  @default(false)
  nextAction                String?
  lastRunAt                 DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  offer                     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  events                    SalesAutomationEvent[]

  @@index([stage])
  @@index([financingStatus])
  @@index([updatedAt])
}

model SalesAutomationEvent {
  id        Int      @id @default(autoincrement())
  caseId    Int
  type      String
  message   String
  createdAt DateTime @default(now())
  automationCase SalesAutomationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([createdAt])
}

model OwnerLoginAttempt {
  key          String   @id
  failures     Int      @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime @updatedAt
}
